@startuml BDD - Schéma relationnel
title BDD - Schéma relationnel
!theme plain
hide circle

entity Item {
    <u>id</u>
    --
    name
    priceExVAT
    VATPercentage
    leftInStock
    description
    image
}

entity Referent {
    <u>id</u>
    --
    designation
    name
    birthDate
    website
    isAlive : bool
}

entity "Order" as OrderTable {
    <u>id</u>
    --
    receiverFirstName
    receiverLastName
    creationTime
    employeeId
    shippingAddressId
}

entity OrderLine {
    <u>orderId</u>
    <u>itemId</u>
    --
    quantity
    priceAtTheTime
}

entity Coupon {
    <u>code</u>
    --
    discountPercentage
}

entity Employee {
    <u>id</u>
    --
    firstName
    lastName
    hiringDate
    salary
}

entity Country {
    <u>name</u>
    --
    isSupported : bool
}

entity Locality {
    <u>id</u>
    --
    name
    zipCode
    isSupported : bool
    countryName
}

entity Address {
    <u>id</u>
    --
    isPickupPoint : bool
    numInStreet
    streetName
    box
    localityId
}
note top of Address : Is only created when selected,\n except for pickup points

entity OrderCoupon {
    <u>orderId</u>
    <u>couponCode</u>
}

entity ItemReferent {
    <u>itemId</u>
    <u>referentId</u>
}

OrderTable::employeeId --> Employee::id
OrderTable::shippingAddressId --> Address::id
OrderLine::orderId --> OrderTable::id
OrderLine::itemId --> Item::id
Locality::countryName --> Country::name
Address::localityId --> Locality::id
OrderCoupon::orderId --> OrderTable::id
OrderCoupon::couponCode --> Coupon::code
ItemReferent::itemId --> Item::id
ItemReferent::referentId --> Referent::id
@enduml